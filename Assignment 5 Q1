#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;
    Node(int val) {
        data = val;
        next = NULL;
    }
};

class LinkedList {
    Node* head;

public:
    LinkedList() {
        head = NULL;
    }

    void insertAtBeg(int val) {
        Node* n = new Node(val);
        n->next = head;
        head = n;
        cout << val << " inserted at beginning\n";
    }

    void insertAtEnd(int val) {
        Node* n = new Node(val);
        if (head == NULL) {
            head = n;
        } else {
            Node* temp = head;
            while (temp->next != NULL)
                temp = temp->next;
            temp->next = n;
        }
        cout << val << " inserted at end\n";
    }

    void insertBefore(int val, int beforeVal) {
        if (head == NULL) {
            cout << "List is empty!\n";
            return;
        }
        if (head->data == beforeVal) {
            insertAtBeg(val);
            return;
        }
        Node* temp = head;
        Node* prev = NULL;
        while (temp != NULL && temp->data != beforeVal) {
            prev = temp;
            temp = temp->next;
        }
        if (temp == NULL) {
            cout << beforeVal << " not found!\n";
            return;
        }
        Node* n = new Node(val);
        prev->next = n;
        n->next = temp;
        cout << val << " inserted before " << beforeVal << endl;
    }

    void insertAfter(int val, int afterVal) {
        Node* temp = head;
        while (temp != NULL && temp->data != afterVal)
            temp = temp->next;
        if (temp == NULL) {
            cout << afterVal << " not found!\n";
            return;
        }
        Node* n = new Node(val);
        n->next = temp->next;
        temp->next = n;
        cout << val << " inserted after " << afterVal << endl;
    }

    void deleteBeg() {
        if (head == NULL) {
            cout << "List is empty!\n";
            return;
        }
        Node* temp = head;
        head = head->next;
        cout << temp->data << " deleted from beginning\n";
        delete temp;
    }

    void deleteEnd() {
        if (head == NULL) {
            cout << "List is empty!\n";
            return;
        }
        if (head->next == NULL) {
            cout << head->data << " deleted from end\n";
            delete head;
            head = NULL;
            return;
        }
        Node* temp = head;
        while (temp->next->next != NULL)
            temp = temp->next;
        cout << temp->next->data << " deleted from end\n";
        delete temp->next;
        temp->next = NULL;
    }

    void deleteNode(int val) {
        if (head == NULL) {
            cout << "List is empty!\n";
            return;
        }
        if (head->data == val) {
            Node* temp = head;
            head = head->next;
            cout << val << " deleted\n";
            delete temp;
            return;
        }
        Node* temp = head;
        Node* prev = NULL;
        while (temp != NULL && temp->data != val) {
            prev = temp;
            temp = temp->next;
        }
        if (temp == NULL) {
            cout << val << " not found!\n";
            return;
        }
        prev->next = temp->next;
        cout << val << " deleted\n";
        delete temp;
    }

    void search(int val) {
        Node* temp = head;
        int pos = 1;
        while (temp != NULL) {
            if (temp->data == val) {
                cout << val << " found at position " << pos << endl;
                return;
            }
            temp = temp->next;
            pos++;
        }
        cout << val << " not found!\n";
    }

    void display() {
        if (head == NULL) {
            cout << "List is empty!\n";
            return;
        }
        Node* temp = head;
        cout << "Linked List: ";
        while (temp != NULL) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
};

int main() {
    LinkedList l;
    int ch = 0, val, key;

    while (ch != 9) {
        cout << "\n1. Insert at Beginning\n2. Insert at End\n3. Insert Before Node\n4. Insert After Node";
        cout << "\n5. Delete from Beginning\n6. Delete from End\n7. Delete Specific Node\n8. Search Node\n9. Display List\n10. Exit\n";
        cout << "Enter your choice: ";
        cin >> ch;

        if (ch == 1) {
            cout << "Enter value: ";
            cin >> val;
            l.insertAtBeg(val);
        } else if (ch == 2) {
            cout << "Enter value: ";
            cin >> val;
            l.insertAtEnd(val);
        } else if (ch == 3) {
            cout << "Enter value and node before which to insert: ";
            cin >> val >> key;
            l.insertBefore(val, key);
        } else if (ch == 4) {
            cout << "Enter value and node after which to insert: ";
            cin >> val >> key;
            l.insertAfter(val, key);
        } else if (ch == 5) {
            l.deleteBeg();
        } else if (ch == 6) {
            l.deleteEnd();
        } else if (ch == 7) {
            cout << "Enter node value to delete: ";
            cin >> val;
            l.deleteNode(val);
        } else if (ch == 8) {
            cout << "Enter node value to search: ";
            cin >> val;
            l.search(val);
        } else if (ch == 9) {
            l.display();
        } else if (ch == 10) {
            cout << "Exiting...\n";
            break;
        } else {
            cout << "Invalid choice!\n";
        }
    }
    return 0;
}
