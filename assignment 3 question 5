#include <iostream>
#include <stack>
using namespace std;

int main() {
    string exp;
    cout << "Enter postfix expression: ";
    cin >> exp;
    stack<int> s;

    for (int i = 0; i < exp.size(); i++) {
        char c = exp[i];
        if (c >= '0' && c <= '9') {
            s.push(c - '0');
        } else {
            int b = s.top(); s.pop();
            int a = s.top(); s.pop();
            if (c == '+') s.push(a + b);
            else if (c == '-') s.push(a - b);
            else if (c == '*') s.push(a * b);
            else if (c == '/') s.push(a / b);
        }
    }

    cout << "Result: " << s.top() << endl;
    return 0;
}
