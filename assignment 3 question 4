#include<iostream>
#include<stack>
#include<string>
using namespace std;
int prior(char ch){
    if(ch=='+'||ch=='-')return 1;
    if(ch=='*'||ch=='/')return 2;
    if(ch=='(') return 3;
    return -1;
}
string solve(string val1,string val2,char ch){
    string ans=val1;
    ans+=val2;
    ans.push_back(ch);
    return ans;
}
string PostfixConversion(string s){
    stack<string>val;
    stack<char>op;
    for(int i=0;i<s.length();i++){
        if(s[i]>=48&&s[i]<58){
            val.push(to_string(s[i]-48));
        }
        else{
            if(op.size()==0) op.push(s[i]);
            else if(prior(s[i])>prior(op.top())) op.push(s[i]);
            else  if(op.top()=='('){
                if(s[i]<48||s[i]>=58){
                    op.push(s[i]);
                }
            }
            else if(s[i]==')'){
                string val2=val.top();
                val.pop();
                string val1=val.top();
                val.pop();
                char ch=op.top();
                op.pop();
                string ans=solve(val1,val2,ch);
                val.push(ans);
                op.pop();
            }
            
            else{
                while(op.size()>0&&prior(op.top())>=prior(s[i])){
                    string val2=val.top();
                    val.pop();
                    string val1=val.top();
                    val.pop();
                    char ch=op.top();
                    op.pop();
                    string ans=solve(val1,val2,ch);
                    val.push(ans);
                }
                op.push(s[i]);
            }
        }
    }
    while(op.size()>0){
            string val2=val.top();
            val.pop();
            string val1=val.top();
              val.pop();
            char ch=op.top();
            op.pop();
            string ans=solve(val1,val2,ch);
            val.push(ans);
        }
    return val.top();
}
int main(){
    string s="2*(3+4)-2/8+5";
    cout<<PostfixConversion(s);
}
